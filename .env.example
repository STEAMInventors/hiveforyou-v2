# ============================================================
# HiveForYou V2 — Local Development
# ============================================================


# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
NODE_ENV=development


# ------------------------------------------------------------
# Supabase
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — never expose to browser/client code
SUPABASE_SERVICE_ROLE_KEY=


# ------------------------------------------------------------
# Supabase Storage
# ------------------------------------------------------------
HIVE_STORAGE_BUCKET=case-documents


# ------------------------------------------------------------
# Hive Engine 1 — Document Discovery
# ------------------------------------------------------------

# fixture = deterministic local fixture engine (optional; default uses MODEL_PROVIDER when keys are set)
# HIVE_DISCOVER_ENGINE=fixture

HIVE_DISCOVER_REASONING_EFFORT=medium
# discover-v1 = legacy one-pass Engine 1 (default)
# discover-v2 = adaptive discovery + Structure Map (recommended)
HIVE_DISCOVER_PROMPT_VERSION=discover-v2

# ------------------------------------------------------------
# Hive Canonical Study / Engine 2
# ------------------------------------------------------------

# fixture = deterministic local fixture engine (tests / explicit dev only)
# HIVE_CANONICAL_STUDY_ENGINE=fixture

# Engine 2 uses engine/core/prompts/canonical-study/canonical-study-v4.md (no env switch).

# Pass-level (do not change provider/model — use MODEL_* below)
HIVE_CANONICAL_STUDY_REASONING_EFFORT=medium
HIVE_CANONICAL_STUDY_MAX_OUTPUT_TOKENS=

# Optional second call: skeleton → story writer → validator (off | openai | fixture)
HIVE_STORY_WRITER_ENGINE=off


# ------------------------------------------------------------
# Model provider (all CallModel sites: discover, study, story, Pro export)
# ------------------------------------------------------------

# openai (default) | anthropic
MODEL_PROVIDER=openai

# Sole authority for model id (openai default: gpt-5.6-sol, anthropic default: claude-opus-5-5)
MODEL_NAME=

# Default max output tokens for Anthropic adapter (OpenAI uses per-engine HIVE_* vars)
MODEL_MAX_OUTPUT_TOKENS=16000

# SERVER ONLY — never expose to browser/client code
OPENAI_API_KEY=
HIVE_ANTHROPIC_API_KEY=
HIVE_ANTHROPIC_WORKSPACE_ID=

# ------------------------------------------------------------
# Document identity (Intake)
# ------------------------------------------------------------

# SERVER ONLY — never expose to browser/client code.
# Intake document identity calls POST https://jevtypesafeai.com/api/v1/decide (state + questions only).
JEV_API_KEY=

# ------------------------------------------------------------
# Hive Processing
# ------------------------------------------------------------

# inline = intake runs in the Next.js app after() hook (default)
# inngest = queue intake + intake study via worker (hive/intake.requested, hive/study.requested)
HIVE_PIPELINE=inline

# Development only (worker): fail the first extract step once per document to demo Inngest retries.
# HIVE_FAULT_INJECT=extract-once

# Fail closed if no configured/authorized study engine is available
HIVE_FAIL_CLOSED=true


# ------------------------------------------------------------
# Development / Diagnostics
# ------------------------------------------------------------

# Local development only: set HIVE_DEV_AUTO_AUTH=1 with NODE_ENV=development for server-side auto sign-in.
# Never set in production or on Vercel. Do not use NEXT_PUBLIC_* for these values.
HIVE_DEV_AUTO_AUTH=
HIVE_DEV_AUTH_EMAIL=
HIVE_DEV_AUTH_PASSWORD=

# Temporary Vercel preview only (see app/.env.vercel.example). Do not commit values.
# HIVE_PREVIEW_PASSWORD requires HTTP Basic Auth, then signs in HIVE_PREVIEW_AUTH_EMAIL.
# HIVE_PREVIEW_PASSWORD=
# HIVE_PREVIEW_AUTH_EMAIL=
# HIVE_PREVIEW_AUTH_PASSWORD=

# Keep false unless explicitly debugging locally.
# Never log raw uploaded document contents or sensitive answers.
HIVE_DEBUG=false
