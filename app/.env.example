# Public Supabase project URL and anon key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never import this into client components or NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=

# Private Storage bucket for uploaded case documents.
HIVE_STORAGE_BUCKET=case-documents

# MODEL_PROVIDER / MODEL_NAME — see repo root .env.example (sole model authority).

# fixture study only (tests): HIVE_CANONICAL_STUDY_ENGINE=fixture

# Story tab prose (optional second model call after study; uses MODEL_NAME).
# HIVE_STORY_WRITER_ENGINE=openai

# Engine 2 uses the version-controlled canonical-study-v3 prompt (no env switch).

# Local development only — server-side Supabase auto sign-in (see repo root .env.example).
HIVE_DEV_AUTH_EMAIL=
HIVE_DEV_AUTH_PASSWORD=

# Temporary Vercel preview secrets live in app/.env.vercel.example only.
# HIVE_PREVIEW_PASSWORD=
# HIVE_PREVIEW_AUTH_EMAIL=
# HIVE_PREVIEW_AUTH_PASSWORD=
