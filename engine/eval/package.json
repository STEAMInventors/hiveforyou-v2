{
  "name": "@hiveforyou/eval",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "node -e \"process.exit(0)\"",
    "test": "vitest run",
    "golden:draft": "pnpm --filter @hiveforyou/core exec tsx ../eval/scripts/draft-golden.ts",
    "eval": "tsx scripts/eval.ts",
    "reader-experiment:dry-run": "tsx scripts/reader-experiment-dry-run.ts",
    "reader-golden-compare": "tsx scripts/eval.ts --reader-golden-compare",
    "eval:serve": "tsx scripts/serve-grader.ts"
  },
  "dependencies": {
    "@hiveforyou/core": "workspace:*",
    "@hiveforyou/shared": "workspace:*",
    "@supabase/supabase-js": "^2.49.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "tsx": "^4.19.2"
  }
}
