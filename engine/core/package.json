    "./pro-rank-views": "./src/views/pro/rankViews.ts",
    "./pro-validate-sql": "./src/views/pro/validateSql.ts",
    "./pro-export-tables": "./src/views/pro/buildProExportTables.ts",
    "./pro-export-prompt": "./src/views/pro/exportPrompt.ts",
    "./model/call-model": "./src/model/call-model.ts",
    "./pack-study-from-projection": "./src/study/narrative/build-pack-study-from-projection.ts",
    "./case-view-plan": "./src/projections/project-case-view-v2-plan.ts",
    "./study": "./src/study/index.ts",
    "./study/validate-document-evidence": "./src/study/validate-document-evidence.ts",
    "./story/prefer-pack-narrative": "./src/study/story/prefer-pack-narrative.ts",
    "./document/page-model": "./src/document/page-model.ts",
    "./document/assembly": "./src/document/assembly.ts",
    "./document/find-consecutive-word-quote": "./src/document/find-consecutive-word-quote.ts",
    "./atoms/run-atoms": "./src/atoms/run-atoms.ts",
    "./study/shadow/run-shadow-study": "./src/study/shadow/run-shadow-study.ts",
    "./study/shadow/shadow-steps": "./src/study/shadow/shadow-steps.ts",
    "./study/shadow/shadow-v4": "./src/study/shadow/shadow-v4.ts",
