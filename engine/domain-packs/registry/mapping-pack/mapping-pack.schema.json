{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hive.domain-mapping-pack/1.0",
  "title": "Hive Domain Mapping Pack",
  "type": "object",
  "required": ["manifest", "concepts", "documents", "relationships", "personas"],
  "properties": {
    "manifest": {
      "type": "object",
      "required": ["id", "name", "packVersion", "contractVersion", "schemaSections"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "packVersion": { "type": "string" },
        "contractVersion": { "const": "hive.domain-mapping-pack/1.0" },
        "status": { "type": "string" },
        "schemaSections": {
          "type": "array",
          "items": { "enum": ["concepts", "documents", "relationships", "personas"] },
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "concepts": {
      "type": "object",
      "required": ["version", "concepts"],
      "properties": {
        "version": { "type": "string" },
        "concepts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "valueKind"],
            "properties": {
              "id": { "type": "string", "pattern": "^[^.]+\\.[^.]+$" },
              "canonicalTypeId": { "type": "string" },
              "valueKind": { "type": "string" }
            }
          }
        }
      }
    },
    "documents": {
      "type": "object",
      "required": ["version", "documentProfiles"],
      "properties": {
        "version": { "type": "string" },
        "documentProfiles": { "type": "array" }
      }
    },
    "relationships": {
      "type": "object",
      "required": ["version", "relationships"],
      "properties": {
        "version": { "type": "string" },
        "relationships": { "type": "array" }
      }
    },
    "personas": {
      "type": "object",
      "required": ["version", "personas"],
      "properties": {
        "version": { "type": "string" },
        "personas": { "type": "array" }
      }
    }
  }
}
