      ],
      "to": [
        "measurement.value",
        "service.minutes_per_week",
        "eligibility.decision"
      ],
      "primitive": "conflict",
      "require": [
        "same_resolved_subject",
        "same_compatible_measure_or_property",
        "overlapping_effective_or_observation_period",
        "incompatible_values",
        "both_sided_evidence"
      ],
      "onUncertain": "unresolved"
    },
    {
      "id": "changed_from",
      "from": [
        "goal.statement",
        "service.minutes_per_week",
