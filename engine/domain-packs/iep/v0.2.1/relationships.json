        "goal.statement",
        "service.minutes_per_week",
        "accommodation.description",
        "eligibility.category"
      ],
      "primitive": "change",
      "require": [
        "same_resolved_identity",
        "ordered_distinct_effective_periods",
        "comparable_properties",
        "both_sided_evidence"
      ],
      "onUncertain": "unresolved"
    },
    {
      "id": "has_service",
      "from": [
        "document.title"
      ],
      "to": [
        "service.type"
      ],
      "primitive": "matches",
      "require": [
        "same_source_document",
        "resolved_service_occurrence",
        "traceable_evidence"
      ],
      "onUncertain": "unresolved"
    }
