        "document.reference"
      ],
      "to": [
        "eligibility.decision",
        "eligibility.category"
      ],
      "primitive": "matches",
      "require": [
        "same_subject",
        "explicit_or_supported_lineage",
        "compatible_effective_time",
        "traceable_evidence"
      ],
      "onUncertain": "unresolved"
    },
    {
