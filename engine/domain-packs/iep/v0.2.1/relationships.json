  "sameNumericValueNeverEnough": true,
  "preserveIndependentOccurrences": true,
  "relationshipSemantics": {
    "conflicts_with": "only_same_subject_and_overlapping_periods_with_incompatible_assertions",
    "changed_from": "only_ordered_distinct_periods_and_identity_resolved",
    "unknownTemporalOrIdentity": "unresolved_not_conflict",
    "restates": "relationship_only_does_not_delete_source_occurrences"
  }
