{
  "name": "@hiveforyou/worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.4"
  },
  "scripts": {
    "build": "node scripts/bundle.mjs",
    "dev": "node --env-file=.env.local node_modules/tsx/dist/cli.mjs watch src/main.ts",
    "start": "node --env-file=.env.local node_modules/tsx/dist/cli.mjs src/main.ts",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "finalize:intake-backfill": "node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/finalize-intake-runs-backfill.ts",
    "compare:intake-runs": "node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/compare-intake-runs.ts",
    "compare:study-runs": "node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/compare-study-runs.ts",
    "backfill:study-projections": "node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/backfill-study-projections.ts"
  },
  "dependencies": {
    "@gutenye/ocr-node": "^1.4.8",
    "@hiveforyou/canonical": "workspace:*",
    "@hiveforyou/core": "workspace:*",
    "@hiveforyou/model-providers": "workspace:*",
    "@hiveforyou/domain-packs": "workspace:*",
    "@hiveforyou/intake": "workspace:*",
    "@hiveforyou/intake-node": "workspace:*",
    "@hiveforyou/shared": "workspace:*",
    "@napi-rs/canvas": "^0.1.80",
    "@supabase/supabase-js": "^2.49.4",
    "inngest": "^4.21.1",
    "pdfjs-dist": "^5.6.205"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
