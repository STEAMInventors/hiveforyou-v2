# Host secrets only (/etc/hive-worker/worker.env). Non-secret config: deploy/oracle/worker.config.env (committed).
SUPABASE_SERVICE_ROLE_KEY=
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=
OPENAI_API_KEY=
HIVE_ANTHROPIC_API_KEY=
JEV_API_KEY=

# Reader verifier + trace ingest (localhost worker listener; shared with hive-agents via network namespace).
HIVE_VERIFIER_TOKEN=
HIVE_AGENT_TRACE_TOKEN=

# DSPy study agents HTTP API (Bearer); do not set HIVE_AGENTS_ALLOW_NONPERSISTENT_AUDIT in production.
HIVE_AGENTS_SERVICE_TOKEN=
