# Committed hive-agents non-secret config. Secrets: /etc/hive-worker/worker.env (loaded after this file).
# LITELLM_BASE_URL and LITELLM_API_KEY live in /etc/hive-worker/worker.env.
MODEL_MAX_OUTPUT_TOKENS=16000
MODEL_HARVESTER=gemini/gemini-1.5-flash
MODEL_HEAVY_LIFTER=gpt-4o

HIVE_AGENTS_JSON=/app/pack/agents.json
HIVE_AGENTS_BIND_HOST=127.0.0.1
HIVE_AGENTS_BIND_PORT=4320

HIVE_VERIFIER_PORT=4319
HIVE_VERIFIER_URL=http://127.0.0.1:4319
HIVE_AGENT_TRACE_URL=http://127.0.0.1:4319
